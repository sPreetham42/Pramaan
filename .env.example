# PRAMAAN environment configuration.
# Copy to `.env` and adjust for your machine.
# Values below are development-only defaults — none are real secrets.

# --- Application ---
APP_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=pramaan
POSTGRES_PASSWORD=pramaan_dev_password
POSTGRES_DB=pramaan
# Used by the backend when run outside Docker (docker-compose overrides it
# to point at the `postgres` service). Host port 5433 avoids colliding with
# a local PostgreSQL on 5432.
DATABASE_URL=postgresql+psycopg://pramaan:pramaan_dev_password@localhost:5433/pramaan

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=pramaan-minio
MINIO_SECRET_KEY=pramaan_minio_dev_secret
MINIO_BUCKET=pramaan-evidence
MINIO_SECURE=false

# --- Frontend ---
# Base URL for API calls from the browser. Leave empty when served behind
# the same origin (Docker/nginx or the Vite dev proxy).
VITE_API_BASE_URL=
